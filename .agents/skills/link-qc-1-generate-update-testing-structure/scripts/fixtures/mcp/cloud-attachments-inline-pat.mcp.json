{
  "mcpServers": {
    "azure-devops": {
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp", "example-org", "--authentication", "pat"],
      "env": { "PERSONAL_ACCESS_TOKEN": "${AZURE_DEVOPS_PAT_B64}" }
    },
    "azure-devops-attachments": {
      "command": "node",
      "args": [".claude/mcp-launchers/azure-devops-attachments.cjs"],
      "env": {
        "AZURE_DEVOPS_ORG_URL": "https://dev.azure.com/example-org",
        "AZURE_DEVOPS_AUTH_METHOD": "pat",
        "AZURE_DEVOPS_PAT": "notarealtoken0000000000000000000000000000000000000000",
        "AZURE_DEVOPS_DEFAULT_PROJECT": "ExampleProject"
      }
    }
  }
}
