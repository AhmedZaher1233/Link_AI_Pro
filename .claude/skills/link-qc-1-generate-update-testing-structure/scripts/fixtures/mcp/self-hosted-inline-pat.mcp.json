{
  "mcpServers": {
    "azure-devops": {
      "command": "npx",
      "args": ["-y", "@tiberriver256/mcp-server-azure-devops"],
      "env": {
        "AZURE_DEVOPS_ORG_URL": "https://devops.example.com/DefaultCollection",
        "AZURE_DEVOPS_AUTH_METHOD": "pat",
        "AZURE_DEVOPS_PAT": "notarealtoken0000000000000000000000000000000000000000",
        "AZURE_DEVOPS_DEFAULT_PROJECT": "ExampleProject"
      }
    }
  }
}
